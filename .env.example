# ===========================
# AutoApply AI — Environment Variables
# ===========================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Database ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=autoapply
DATABASE_PASSWORD=autoapply_dev_2026
DATABASE_NAME=autoapply_db
DATABASE_URL=postgresql://autoapply:autoapply_dev_2026@localhost:5432/autoapply_db

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── JWT ──
JWT_SECRET=dev-jwt-secret-change-in-production-autoapply-2026
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-autoapply-2026
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# ── Gemini AI ──
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── Application ──
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ── File Storage ──
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ── Encryption (for credential storage) ──
CREDENTIAL_ENCRYPTION_KEY=dev-encryption-key-32-chars-here!
