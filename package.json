{
  "name": "autoapply-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AutoApply AI — AI-driven career automation platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
